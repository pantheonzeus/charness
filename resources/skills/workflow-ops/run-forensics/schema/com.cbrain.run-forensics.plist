<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cbrain.run-forensics</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>R=resources/skills/workflow-ops/run-forensics/scripts; /usr/bin/python3 scripts/session_archive.py sync; /usr/bin/python3 $R/sessions.py scan; /usr/bin/python3 $R/forensics.py report</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOU/GitHub/cbrain</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOU/GitHub/cbrain/output/run-forensics/run-forensics.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/GitHub/cbrain/output/run-forensics/run-forensics.log</string>
</dict>
</plist>
